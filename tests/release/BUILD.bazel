load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# The release suite's driving library (T4.1): shared PTY-driving primitives,
# read-only miniflux_v2 navigation, and the per-scenario capture functions. The
# live-tagged py_test targets that `bazel test --test_tag_filters=live //...`
# discovers are declared below as each scenario's own capture is finalized.
#
# analyze-reanalysis-noop still has no way to learn a prior analysis exists
# except by its own initiative -- the phase prompts never mention it -- and a
# first attempt (no hint) reliably produced noisy duplicate-then-reconcile
# content instead of a clean no-op; its own py_test below uses a different
# strategy (an explicit chat hint) and only finalizes the capture if the real
# run actually converges to a genuine zero-diff, per the global rule against
# forcing a scenario's shape.
py_library(
    name = "release_lib",
    srcs = [
        "__init__.py",
        "capture.py",
        "miniflux_repo.py",
        "scenario_driver.py",
    ],
    imports = [".."],
    deps = [
        "//src/blare:blare_lib",
        "//tests/e2e:pty_harness",
    ],
)

py_test(
    name = "test_capture_analyze_happy_path",
    srcs = [
        "test_capture_analyze_happy_path.py",
        "//:pytest_main.py",
    ],
    args = ["$(location :test_capture_analyze_happy_path.py)"],
    legacy_create_init = False,
    main = "//:pytest_main.py",
    # no-sandbox/local: this test's own side effect (finalize_capture) writes
    # back into the source tree's tests/fixtures/claude-sdk/ -- and it drives
    # a subprocess against ~/external_git/miniflux_v2, an absolute path outside
    # the workspace a sandboxed action couldn't reach at all. exclusive: every
    # live target shares mutable state (the same real checkout's .blare/) and
    # must not run concurrently with another one.
    data = ["//src/blare:blare"],
    # env_inherit: every scenario in this package resolves the real checkout
    # via `Path.home()` (miniflux_repo.MINIFLUX_ROOT) -- Bazel's test wrapper
    # otherwise substitutes a synthetic, sandboxed HOME even for tags =
    # ["local", "no-sandbox"], which would silently point every capture at an
    # empty throwaway directory instead of the real ~/external_git/miniflux_v2.
    env_inherit = ["HOME"],
    tags = ["exclusive", "live", "local", "no-sandbox"],
    timeout = "eternal",
    deps = [
        ":release_lib",
        "@pip//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

