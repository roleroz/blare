load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# The release suite's driving library (T4.1): shared PTY-driving primitives,
# fresh-kvstore-repo construction (kvstore_repo.py), and the per-scenario
# capture functions. The live-tagged py_test targets that `bazel test
# --test_tag_filters=live //...` discovers are declared below as each
# scenario's own capture is finalized. Every capture now builds its own fresh
# kvstore repo inside its own test's tmp_path, so no live target shares
# mutable state with another and none needs to run exclusively of the rest
# (decisions.md 2026-08-01).
#
# analyze-reanalysis-noop still has no way to learn a prior analysis exists
# except by its own initiative -- the phase prompts never mention it -- and a
# first attempt (no hint) reliably produced noisy duplicate-then-reconcile
# content instead of a clean no-op; its own py_test below uses a different
# strategy (an explicit chat hint) and only finalizes the capture if the real
# run actually converges to a genuine zero-diff, per the global rule against
# forcing a scenario's shape.
py_library(
    name = "release_lib",
    srcs = [
        "__init__.py",
        "capture.py",
        "kvstore_repo.py",
        "scenario_driver.py",
    ],
    imports = [".."],
    deps = [
        "//src/blare:blare_lib",
        "//tests/e2e:pty_harness",
    ],
)

py_test(
    name = "test_capture_analyze_happy_path",
    srcs = [
        "test_capture_analyze_happy_path.py",
        "//:pytest_main.py",
    ],
    args = ["$(location :test_capture_analyze_happy_path.py)"],
    legacy_create_init = False,
    main = "//:pytest_main.py",
    # no-sandbox/local: this test's own side effect (finalize_capture) writes
    # back into the source tree's tests/fixtures/claude-sdk/ -- a sandboxed
    # action couldn't reach the source tree at all. No exclusive tag needed:
    # each capture builds its own fresh, private kvstore repo (kvstore_repo.py)
    # inside its own test's tmp_path, so concurrent live targets never share
    # mutable state (decisions.md 2026-08-01).
    data = ["//src/blare:blare"],
    tags = ["live", "local", "manual", "no-sandbox"],
    timeout = "eternal",
    deps = [
        ":release_lib",
        "@pip//pytest_bazel",
        "@rules_python//python/runfiles",
    ],
)

