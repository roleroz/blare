{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git merge*)",
            "command": "bash -c \"$(jq -r .full .claude/test-commands.json)\" || exit 2",
            "timeout": 600,
            "statusMessage": "Running the full suite before merge"
          }
        ]
      }
    ]
  }
}
